
# 通用
ENV=production
API_BASE_URL=http://127.0.0.1:8000
SCREENSHOT_BASE_URL=http://127.0.0.1:8000/static/screenshots
STATIC=/static # 外部访问路径（URL 前缀）
OUT_DIR=./static/screenshots    # 本地输出目录
IMAGE_BASE_URL=/static/screenshots  # 图片访问 URL
DATA_DIR=data

# HuggingFace 国内镜像（国内网络必须配置）
HF_ENDPOINT=https://hf-mirror.com

# transcriber 相关配置
TRANSCRIBER_TYPE=fast-whisper # fast-whisper/bcut/kuaishou
WHISPER_MODEL_SIZE=base

# 阿里云 OSS 配置（用于 MinerU PDF 解析文件存储）
OSS_ACCESS_KEY_ID=your_access_key_id
OSS_ACCESS_KEY_SECRET=your_access_key_secret
OSS_BUCKET_NAME=your_bucket_name
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com  # 根据实际区域修改
OSS_REGION=cn-hangzhou  # Bucket 所在区域

# LLM API 配置
# 注意：现代模型通常支持 128k-200k tokens 上下文
# 45MB 字节限制适用于大多数场景，如遇到 token 超限可适当降低
OPENAI_MAX_REQUEST_BYTES=47185920  # 最大请求字节数（默认 45MB，约对应 100k-150k tokens）
# 图片 chunk 比例：因为图片会消耗大量 tokens（每张约 1000-2000 tokens）
# 200k 上下文模型建议 0.4-0.6，128k 模型建议 0.3-0.4
OPENAI_IMAGE_CHUNK_RATIO=0.5  # 包含图片的 chunk 字节限制比例（默认 50%，适用于 200k 上下文模型）
OPENAI_RETRY_ATTEMPTS=3  # API 重试次数
OPENAI_RETRY_BACKOFF_SECONDS=1.5  # 重试退避时间（秒）
LLM_CHUNK_MAX_WORKERS=5  # 并发处理 chunk 的工作线程数